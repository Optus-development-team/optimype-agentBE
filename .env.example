# ==============================================================================
# Servidor HTTP
# ==============================================================================
# Puerto en el que escucha la aplicación NestJS
PORT='3000'

# ==============================================================================
# Meta / WhatsApp Cloud API
# ==============================================================================
# Versión de la API de Meta Graph (ej: v21.0)
WHATSAPP_API_VERSION='v21.0'

# Token de acceso de Meta (Bearer Token para llamadas a Graph API)
META_API_TOKEN=''

# Token secreto configurado en el Dashboard de Desarrolladores de Meta para verificar el webhook de WhatsApp
WHATSAPP_VERIFY_TOKEN=''

# Si es 'true', envía una confirmación textual del agente antes/después del flujo ADK
ADK_SEND_AGENT_TEXT='false'

# Tiempo en milisegundos de espera/debounce para agrupar mensajes entrantes antes de procesar
WAIT_UNTIL_MESSAGE='3000'

# Si es 'true', procesa mensajes de WhatsApp de forma síncrona (recomendado en entornos serverless como Vercel)
WHATSAPP_PROCESS_MESSAGES_SYNC='false'

# (Opcional - Desarrollo) ID del número de teléfono (phone_number_id) del tenant para filtrar y aceptar mensajes únicamente hacia él.
# Solo está activo si NODE_ENV='development' y esta variable tiene un valor no vacío.
DEV_TENANT_PHONE_NUMBER_ID=''

# ==============================================================================
# Autenticación y Seguridad (JWT / Cifrado)
# ==============================================================================
# Secreto para firmar tokens de sesión generales de la aplicación
APP_JWT_SECRET=''

# Tiempo de vida (TTL) en milisegundos de los tokens de sesión de la aplicación (ej: 86400000 = 24 horas)
APP_JWT_TTL_MS='86400000'

# Secreto para firmar tokens JWT de autenticación de usuario (si no se define, usa APP_JWT_SECRET como fallback)
AUTH_JWT_SECRET=''

# Tiempo de vida (TTL) en milisegundos de los tokens de autenticación de usuario (ej: 43200000 = 12 horas)
AUTH_JWT_TTL_MS='43200000'

# Llave de cifrado AES-256 para credenciales sensibles de integraciones (OAuth tokens, etc.)
ENCRYPTION_KEY=''

# ==============================================================================
# Configuración del Sistema
# ==============================================================================
# Moneda por defecto para el sistema y órdenes (ej: USD, BOB)
DEFAULT_CURRENCY='USD'

# ==============================================================================
# URLs de la Aplicación y Frontend
# ==============================================================================
# URL principal de la aplicación/landing page (usada para redirecciones de login y links de checkout)
MAIN_PAGE_URL=''

# URL del dashboard frontend (usada para redirección tras autenticación exitosa)
FRONTEND_DASHBOARD_URL=''

# ==============================================================================
# Google OAuth & Calendar Integration
# ==============================================================================
# Client ID de Google Cloud Console para autenticación OAuth2 y sincronización de Google Calendar
GOOGLE_OAUTH_CLIENT_ID=''

# Client Secret de Google Cloud Console para intercambio de tokens OAuth2
GOOGLE_OAUTH_CLIENT_SECRET=''

# ID de empresa asociado por defecto durante el flujo de registro mediante Google OAuth
GOOGLE_REGISTRATION_COMPANY_ID=''

# URL pública de callback para Google OAuth (debe coincidir con la registrada en Google Cloud Console)
GOOGLE_CALLBACK_URL=''

# Entorno de ejecución de la aplicación: 'development', 'production' o 'test'
NODE_ENV='development'

# URL pública HTTPS del webhook del backend para recibir notificaciones push de cambios en Google Calendar
GOOGLE_CALENDAR_WEBHOOK_URL='https://api.example.com/v1/webhooks/google-calendar'

# ==============================================================================
# Servicio de Verificación ZK (Proving Service)
# ==============================================================================
# URL base del servicio externo de generación/verificación de pruebas de identidad Zero-Knowledge
PROVING_SERVICE_API_URL=''

# ==============================================================================
# Inteligencia Artificial (Google Gemini)
# ==============================================================================
# API Key de Google AI Studio para los modelos Gemini del orquestador y formateadores
GOOGLE_GENAI_API_KEY=''

# Modelo de Google Gemini a utilizar por el agente ADK (ej: gemini-2.5-flash, gemini-1.5-flash)
GOOGLE_GENAI_MODEL='gemini-2.5-flash'

# ==============================================================================
# Base de Datos (Supabase / PostgreSQL)
# ==============================================================================
# Cadena de conexión PostgreSQL (URI de conexión directa o connection pooler de Supabase)
SUPABASE_DB_URL=''

# Tamaño máximo del pool de conexiones PostgreSQL (por defecto: 5)
SUPABASE_DB_POOL_SIZE='5'

# Permite certificados auto-firmados en conexión SSL de base de datos ('true'/'false')
SUPABASE_DB_ALLOW_SELF_SIGNED='false'

# Ruta al archivo del certificado CA SSL para la conexión a la base de datos
SUPABASE_DB_CA_FILE=''

# Certificado CA SSL codificado en Base64 para conexión a la base de datos
SUPABASE_DB_CA_BASE64=''

# Contenido en texto plano del certificado CA SSL para conexión a la base de datos
SUPABASE_DB_CA_CERT=''

# ==============================================================================
# Protocolo de Pagos x402 (Web3 / Stablecoins)
# ==============================================================================
# URL del servicio facilitador de pagos x402 (por defecto https://x402.org/facilitator)
FACILITATOR_URL='https://x402.org/facilitator'

# API Key interna para autenticar solicitudes con el facilitador x402
FACILITATOR_INTERNAL_API_KEY=''

# ==============================================================================
# Zona Horaria
# ==============================================================================
# Zona horaria IANA por defecto cuando no se infiere del número de teléfono (ej: America/La_Paz, UTC)
TIMEZONE_FALLBACK='America/La_Paz'

# ==============================================================================
# Stickers de WhatsApp (URLs opcionales para personalizar stickers por evento)
